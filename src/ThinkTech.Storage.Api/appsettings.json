{
  // LOCAL DEVELOPMENT SETTINGS.
  // This file is NOT copied by 'dotnet publish' (see the .csproj), so the dev signing key and
  // dev clients below never reach the server. The server reads its complete configuration from
  // the file named by THINKTECH_STORAGE_SETTINGS (template: deploy/settings.sample.json).
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Data Protection is not used by this API (no cookies); hide its key-storage warnings.
      "Microsoft.AspNetCore.DataProtection": "Error"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "thinktech-storage-api",
    "Audience": "thinktech-storage-clients",
    // Dev-only key. Production uses its own key from 'generate-signing-key'.
    "SigningKey": "Oj5uDO6yMmmytQ5LThgx_ipDifY0KmWguYw1_Lh3bVkmVGOn5G_hl2vLfgzQktzGMbXZqHKpCtkkTFjgB9NCfg",
    "AccessTokenMinutes": 60
  },

  "Storage": {
    // Relative to the project folder; git-ignored.
    "RootPath": "App_Data/storage",
    "MaxFileSizeBytes": 104857600,
    "AllowedExtensions": [
      ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".odt", ".ods", ".rtf", ".txt", ".csv",
      ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tif", ".tiff", ".webp", ".heic",
      ".xml", ".json", ".zip", ".7z", ".dcm"
    ]
  },

  // Dev clients for local testing. Their secrets are in ThinkTech.Storage.Api.http.
  "StorageClients": {
    "Clients": [
      {
        "ClientId": "dev-console",
        "DisplayName": "Local development client (full access)",
        "SecretHash": "pbkdf2-sha256.100000.4AwAjv_h8pYAL965yok-pg.IuYRN1P79dTgCget0kIW87OdeZNYN4YyZzEwPSNUDVg",
        "Scopes": [ "storage.read", "storage.write", "storage.delete" ],
        "Enabled": true
      },
      {
        "ClientId": "dev-readonly",
        "DisplayName": "Local development client (read only)",
        "SecretHash": "pbkdf2-sha256.100000.6eGacnkIU8Ck_2I54hHn7A.3qGgja1TpnJPAZ2wzZaxfa3SdZqV3HRG9I0JI_z7wlg",
        "Scopes": [ "storage.read" ],
        "Enabled": true
      }
    ]
  }
}
