{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Data Protection is not used by this API (no cookies); hide its key-storage warnings on Linux.
      "Microsoft.AspNetCore.DataProtection": "Error"
    }
  },
  "AllowedHosts": "*",

  // Secrets are NOT stored here. On the server they come from the file named by the
  // THINKTECH_STORAGE_SETTINGS environment variable (see deploy/settings.sample.json).
  "Jwt": {
    "Issuer": "thinktech-storage-api",
    "Audience": "thinktech-storage-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  },

  "Storage": {
    "RootPath": "/var/lib/thinktech-storage",
    "MaxFileSizeBytes": 104857600,
    "AllowedExtensions": [
      ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".odt", ".ods", ".rtf", ".txt", ".csv",
      ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tif", ".tiff", ".webp", ".heic",
      ".xml", ".json", ".zip", ".7z", ".dcm"
    ]
  },

  "StorageClients": {
    "Clients": []
  }
}
